{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/upload", "destination": "/upload.html" },
    { "source": "/upload/", "destination": "/upload.html" },
    { "source": "/studio-gallery", "destination": "/studio-gallery/index.html" },
    { "source": "/studio-gallery/", "destination": "/studio-gallery/index.html" }
  ]
}
