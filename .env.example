# ==============================================================================
# FRAMEHAUS Google Drive Upload Portal — Environment Configuration
# ==============================================================================
# Configure these variables in your deployment platform (Vercel Project Settings)
# or in a local .env file for development. Never commit sensitive keys to git!
# ==============================================================================

# Google Cloud OAuth 2.0 Credentials (Web Application)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Authorized Google Account Refresh Token
# Generated via OAuth consent flow with scope: https://www.googleapis.com/auth/drive.file
# You can use the built-in setup assistant at /upload?setup=true to generate this.
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token

# Google Drive Destination Folder
# The ID of the private folder where gallery folders and shoot media will be stored.
# Format: string ID from the folder URL (e.g. 1a2B3c4D5e6F7g8H9i0J...)
# Or you can provide the full URL: https://drive.google.com/drive/folders/1a2B3c4D5e6F7g8H9i0J
GOOGLE_DRIVE_FOLDER_ID=your_destination_folder_id

# Friendly Destination Display Name (Shown to authorized uploaders)
# Default: FRAMEHAUS Studio Vault
STUDIO_DESTINATION_NAME="FRAMEHAUS Studio Vault"

# Lightweight Access Gate Passcode (Optional but recommended)
# If set, uploaders must enter this passcode to unlock the upload portal.
# If empty, upload controls are directly accessible to anyone with the link.
UPLOAD_PASSCODE=
